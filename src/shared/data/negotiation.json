{
  "id": "desrec-standard-negotiation",
  "version": "1.0.0",
  "title": "DesREC Negotiation Tool",
  "sections": [
    {
      "id": "general",
      "title": "General",
      "description": "Basic information and goals for this negotiation.",
      "questions": [
        {
          "id": "scene_intention",
          "type": "textarea",
          "title": "What are you hoping to get out of this scene?",
          "allowNotes": false
        },
        {
          "id": "experience_level",
          "type": "singleSelect",
          "title": "Experience Level",
          "allowNotes": false,
          "options": [
            {
              "value": "new",
              "label": "New"
            },
            {
              "value": "some",
              "label": "Some Experience"
            },
            {
              "value": "experienced",
              "label": "Experienced"
            },
            {
              "value": "advanced",
              "label": "Advanced"
            }
          ]
        }
      ]
    },
    {
      "id": "communication",
      "title": "Communication",
      "description": "Discuss communication, check-ins, and scene management.",
      "questions": [
        {
          "id": "safewords",
          "type": "checkboxGroup",
          "title": "Communication Methods",
          "allowNotes": true,
          "options": [
            {
              "value": "green_yellow_red",
              "label": "Green / Yellow / Red"
            },
            {
              "value": "plain_language",
              "label": "Plain Language"
            },
            {
              "value": "nonverbal",
              "label": "Nonverbal Signals"
            },
            {
              "value": "checkins",
              "label": "Regular Check-ins"
            }
          ]
        }
      ]
    },
    {
      "id": "activities",
      "title": "Activities",
      "description": "Discuss activities you are interested in for this scene.",
      "questions": [
        {
          "id": "rope",
          "type": "interest",
          "title": "Rope",
          "allowNotes": true
        },
        {
          "id": "impact",
          "type": "interest",
          "title": "Impact Play",
          "allowNotes": true
        },
        {
          "id": "medical_info",
          "type": "infoCard",
          "title": "Medical Play",
          "description": "Medical play may involve additional health, sanitation, and safety considerations. Make sure you discuss experience, equipment, risks, and emergency planning before engaging."
        },
        {
          "id": "medical_play",
          "type": "interest",
          "title": "Medical Play",
          "allowNotes": true
        }
      ]
    }
  ]
}